
/* Descrption:
   This simple JavaScript program:
  - Prompts the user to enter their name
  - Stores the input in a variable called 'name'
  - Displays a greeting using an alert box
*/

<script>
// Ask the user for their name and store it in the variable 'name'
var name = prompt("What is your name?");

// Display a greeting with the user's name in an alert box
alert("Hi " + name);
</script>
